# Backend for live features ("still this price?" votes). Leave unset to hide them.
# Venues and menus always come from the static JSON in public/data (exported by pipeline/export.py).
VITE_API_BASE=

# Optional raster tiles. Leave unset to draw the bundled OSM vector basemap (works offline).
# Respect the tile provider's usage policy.
VITE_TILE_URL=

# GoatCounter site code for anonymous analytics (the "grubmap" in grubmap.goatcounter.com).
# Leave unset to turn analytics off.
VITE_GOATCOUNTER_CODE=
